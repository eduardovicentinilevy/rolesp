# Variáveis do Docker Compose (Postgres local).
# Copie para .env e troque as senhas: cp .env.example .env

# Senha do superusuário "postgres" (só usado para criar papéis e bancos)
POSTGRES_PASSWORD=troque-senha-superusuario

# Dono do schema: roda migrations e seeds (DDL)
ROLESP_OWNER_PASSWORD=troque-senha-owner

# Usado pela API: só SELECT, INSERT, UPDATE e DELETE
ROLESP_APP_PASSWORD=troque-senha-app

# Porta exposta no host (só em 127.0.0.1)
POSTGRES_PORT=5432
