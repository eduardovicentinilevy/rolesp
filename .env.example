# Copie para .env (na raiz do repositório) e ajuste se quiser: cp .env.example .env
# O .env nunca vai para o Git. Estes valores são só para desenvolvimento local.

# --- Banco local (docker compose) ---
POSTGRES_USER=rolesp
POSTGRES_PASSWORD=rolesp_dev
POSTGRES_DB=rolesp
# Porta publicada só em 127.0.0.1
POSTGRES_PORT=5432

# --- Scripts do backend (npm run db:*) ---
# Mesmo usuário, senha, porta e banco de cima
DATABASE_URL=postgres://rolesp:rolesp_dev@127.0.0.1:5432/rolesp
# development | test | production (em production, os seeds *.dev.sql são pulados e o db:reset recusa rodar)
NODE_ENV=development
