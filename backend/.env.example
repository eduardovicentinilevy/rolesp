# Copie para .env: cp .env.example .env

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# A API conecta com o papel de menor privilégio (só DML)
DATABASE_URL=postgres://rolesp_app:troque-senha-app@localhost:5432/rolesp
# Migrations e seeds rodam com o dono do schema (DDL)
DATABASE_URL_MIGRACAO=postgres://rolesp_owner:troque-senha-owner@localhost:5432/rolesp

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

# Origens que podem chamar a API (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173

# Quantos proxies existem na frente da API (0 local; 1 ou mais no Cloud Run)
TRUST_PROXY=0
